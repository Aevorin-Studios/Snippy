#include <windows.h>
#include "resource.h"

// Application icon (embedded in binary — no runtime file dependency)
IDI_SNIPPY_ICON ICON "icons/snippy.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,6
PRODUCTVERSION  1,0,0,6
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Aevorin Studios"
            VALUE "FileDescription",  "Snippy - Ultra-Fast Screenshot Tool"
            VALUE "FileVersion",      "1.0.0.6"
            VALUE "InternalName",     "Snippy"
            VALUE "LegalCopyright",   "Copyright 2026 Aevorin Studios"
            VALUE "OriginalFilename", "Snippy.exe"
            VALUE "ProductName",      "Snippy"
            VALUE "ProductVersion",   "1.0.0.6"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
